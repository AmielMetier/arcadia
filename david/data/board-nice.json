  "cards": {
    "chance": [
      { "id": "ch01", "text": "Balade du dimanche : avancez jusqu'à la Promenade des Anglais.", "action": { "type": "advance", "to": 39 } },
      { "id": "ch02", "text": "Avancez jusqu'à la case Départ. Recevez 200 €.", "action": { "type": "advance", "to": 0 } },
      { "id": "ch03", "text": "Marché aux fleurs : rendez-vous au Cours Saleya. Si vous passez par Départ, recevez 200 €.", "action": { "type": "advance", "to": 24 } },
      { "id": "ch04", "text": "Raccourci par la voie rapide : filez Boulevard Gambetta. Si vous passez par Départ, recevez 200 €.", "action": { "type": "advance", "to": 11 } },
      { "id": "ch05", "text": "Grève surprise ! Avancez jusqu'au pôle de transport le plus proche. S'il a un propriétaire, payez-lui le double du loyer ; sinon, vous pouvez l'acheter.", "action": { "type": "advanceNearest", "kind": "station", "rentMultiplier": 2 } },
      { "id": "ch06", "text": "Correspondance ratée ! Avancez jusqu'au pôle de transport le plus proche. S'il a un propriétaire, payez-lui le double du loyer ; sinon, vous pouvez l'acheter.", "action": { "type": "advanceNearest", "kind": "station", "rentMultiplier": 2 } },
      { "id": "ch07", "text": "Avancez jusqu'au service d'Azur le plus proche. S'il a un propriétaire, lancez les dés et payez-lui 10 fois le résultat ; sinon, vous pouvez l'acheter.", "action": { "type": "advanceNearest", "kind": "utility", "diceMultiplier": 10 } },
      { "id": "ch08", "text": "Votre stand de socca cartonne : la banque vous verse un dividende de 50 €.", "action": { "type": "collect", "amount": 50 } },
      { "id": "ch09", "text": "Laissez-passer du Carnaval : vous êtes libéré de prison. Conservez cette carte jusqu'à son utilisation ou sa vente.", "action": { "type": "jailFree" } },
      { "id": "ch10", "text": "Vous avez oublié votre serviette sur les galets : reculez de 3 cases.", "action": { "type": "back", "steps": 3 } },
      { "id": "ch11", "text": "Allez en prison. Ne passez pas par Départ, ne recevez pas 200 €.", "action": { "type": "goToJail" } },
      { "id": "ch12", "text": "Ravalement des façades ocre : payez 25 € par maison et 100 € par hôtel.", "action": { "type": "repairs", "house": 25, "hotel": 100 } },
      { "id": "ch13", "text": "Excès de vitesse sur la voie Mathis : amende de 15 €.", "action": { "type": "pay", "amount": 15 } },
      { "id": "ch14", "text": "Prenez le train à la Gare Riquier. Si vous passez par Départ, recevez 200 €.", "action": { "type": "advance", "to": 5 } },
      { "id": "ch15", "text": "Vous présidez le comité du Carnaval : versez 50 € à chaque joueur.", "action": { "type": "payEach", "amount": 50 } },
      { "id": "ch16", "text": "Votre prêt immobilier arrive à échéance : recevez 150 €.", "action": { "type": "collect", "amount": 150 } },
      { "id": "ch17", "text": "Apparition de Sylvain Durif en plein cœur de Nice ! Recevez 100 €. Son buste trône au milieu du plateau pendant 3 tours.", "action": { "type": "collect", "amount": 100, "apparition": "durif", "rounds": 3 } }
    ],
    "chest": [
      { "id": "cc01", "text": "Avancez jusqu'à la case Départ. Recevez 200 €.", "action": { "type": "advance", "to": 0 } },
