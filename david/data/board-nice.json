{
  "id": "nice",
  "title": "DavidSimulator — Édition Nice",
  "version": 1,
  "currency": "€",

  "rules": {
    "startingCash": 1500,
    "goSalary": 200,
    "jailPosition": 10,
    "jailFine": 50,
    "maxJailTurns": 3,
    "doublesToJail": 3,
    "mortgageInterest": 0.10,
    "buildingResaleRatio": 0.5,
    "bankHouses": 32,
    "bankHotels": 12,
    "housesPerHotel": 4,
    "evenBuilding": true,
    "doubleRentOnUnimprovedMonopoly": true,
    "auctionWhenDeclined": true,
    "freeParkingJackpot": false,
    "minPlayers": 2,
    "maxPlayers": 6
  },

  "modes": {
    "classic": {
      "label": "Classique",
      "description": "Règles officielles : la partie se termine quand il ne reste qu'un joueur solvable."
    },
    "express": {
      "label": "Partie Express",
      "description": "Moins de 45 minutes : propriétés offertes, hôtels plus rapides, prison courte, chrono de 40 min.",
      "overrides": { "housesPerHotel": 3, "maxJailTurns": 2 },
      "startingProperties": 3,
      "startingPropertiesNoMonopoly": true,
      "timeLimitMinutes": 40,
      "endOnFirstBankruptcy": true,
      "winner": "highestNetWorth",
      "netWorth": {
        "cash": 1,
        "unmortgagedProperty": "price",
        "mortgagedProperty": "price/2",
        "house": "houseCost",
        "hotel": "houseCost*(housesPerHotel+1)"
      }
    }
  },

  "groups": {
